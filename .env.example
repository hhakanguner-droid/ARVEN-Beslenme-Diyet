# Public origin only. Never place AI, database or storage secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Server-side adapters (actual bindings/secrets are supplied by the deployment platform).
ARVEN_AI_PROVIDER=openai
ARVEN_AI_MODEL=
ARVEN_DATABASE_DRIVER=d1
ARVEN_STORAGE_DRIVER=r2

# Provider credentials are intentionally not committed.
OPENAI_API_KEY=

# Required for a user's own saved AI provider API key (Ayarlar -> Yapay Zeka, "BYOK") to be stored
# at rest with authenticated encryption instead of plaintext (fix/byok-security-hardening). A
# base64-encoded random 32-byte (256-bit) key, e.g. generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must come from a real secret store in production (Cloudflare secret), never be committed here with
# a real value, and never change without a migration plan -- rotating it makes every already-saved
# BYOK key undecryptable. Without this set, saving a new BYOK key fails closed (by design) rather
# than falling back to storing it unencrypted; a key saved before this variable existed keeps working
# as a legacy plaintext row until this is configured, at which point it is migrated to encrypted
# form automatically the next time it's used.
ARVEN_CREDENTIAL_ENCRYPTION_KEY=

# Cloudflare Access (zero-trust edge auth in front of this origin).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDIENCE=

# Open Food Facts (public nutrition database; User-Agent contact string is required by their API policy).
OFF_CONTACT_USER_AGENT=
